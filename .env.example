# Chaves de API dos Provedores de IA Suportados (Configure o provedor desejado)
# Caso nenhuma chave seja definida, o sistema executa automaticamente em Modo Demonstração (Zero-Config).

# 1. Anthropic (Claude Sonnet 4) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-sua-chave-aqui

# 2. OpenAI (GPT-4o Mini) - https://platform.openai.com/
OPENAI_API_KEY=

# 3. Google (Gemini 2.5 Flash) - https://aistudio.google.com/
GEMINI_API_KEY=

# 4. Groq (Llama 3.3 70B) - https://console.groq.com/
GROQ_API_KEY=
